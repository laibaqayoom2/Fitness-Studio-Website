DATABASE_URL=postgresql://user:password@host/dbname
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
PORT=3000
NODE_ENV=development
# Session cookie lifetime in days.
SESSION_TTL_DAYS=7
# lax for same-origin. Use none (with HTTPS) only when client and API are on different sites.
COOKIE_SAMESITE=lax

# Stripe TEST MODE keys. Get them from https://dashboard.stripe.com/test/apikeys
# (test clock not needed; Test mode is free and never moves real money).
STRIPE_SECRET_KEY=sk_test_
# Load "Webhook signing secret" from Stripe CLI: stripe listen --print-secret
# or the Dashboard > Developers > Webhooks page when using a connected endpoint.
STRIPE_WEBHOOK_SECRET=whsec_
